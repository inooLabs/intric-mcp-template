# JWT authentication for the MCP endpoint (HS256, shared secret).
# Copy this file to .env and set the secret. Never commit .env.

# Shared secret that signs and verifies tokens. Required: the server refuses to start without it.
# Generate one with: openssl rand -hex 32
MCP_SERVER_JWT_SECRET=

# Expected "iss" claim. Keep it non-empty: an empty value silently disables the check.
MCP_SERVER_JWT_ISSUER=intric-mcp-template

# Expected "aud" claim. Keep it non-empty: an empty value silently disables the check.
MCP_SERVER_JWT_AUDIENCE=intric-mcp-template-server
